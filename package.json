{
  "name": "@lexiupon/pi-session-correlation",
  "version": "0.1.1",
  "description": "pi extension: stamp session/turn/parent-session correlation headers onto model requests for a fronting proxy.",
  "author": "Alexion Fortytwo <alexion@lexiupon.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexiupon/pi-session-correlation.git"
  },
  "homepage": "https://github.com/lexiupon/pi-session-correlation#readme",
  "bugs": {
    "url": "https://github.com/lexiupon/pi-session-correlation/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "session-correlation",
    "tracing",
    "observability",
    "headers"
  ],
  "type": "module",
  "scripts": {
    "pack:dry-run": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
